   selection_mode.ml video_color_primaries.ml video_matrix_coefficients.ml
   video_pixel_format.ml video_transfer_characteristics.ml
   visibility_state.ml web_gl_power_preference.ml worker_type.ml
   xml_http_request_response_type.ml %{workspace_root}/bin/apply-style
   %{workspace_root}/lib/browser/bin/main.exe)
 (action
  (bash
    "%{workspace_root}/lib/browser/bin/main.exe gen-enums -file-type ml -filtered"))
 (alias runtest))

